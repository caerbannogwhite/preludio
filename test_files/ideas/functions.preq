# NOT RUNNABLE. A design sketch for syntax the language does not have
# yet (user-defined functions, issue #13). Kept as an idea, not as a test.

func function1 a b:2 c -> a + b + c

func function2 foo:(1+2) bar:3 -> 
    a := (from! bar | name!)
    b := (
        from! foo
        sort! rev names
        take! 1
    )
    ret a + foo
end
